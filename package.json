    "@sentry/node": "^10.27.0",
    "@sentry/react": "^10.27.0",
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "i18next": "^25.6.3",
    "jest": "^30.2.0",
    "jsdoc": "^4.0.5",
    "memlab": "^1.1.60",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.5",
    "react-scripts": "^5.0.1",
